# 複製成 .env 後使用，.env 不可 commit。
# 後端（app/core/config.py）與 docker compose 都讀這份。

# --- PostgreSQL 容器（docker-compose.yml）---
POSTGRES_USER=foodflow
# 僅供本機開發容器使用，請勿用於任何對外環境。
POSTGRES_PASSWORD=foodflow_local_dev
POSTGRES_DB=foodflow
# 修改時要同步修改下方 DATABASE_URL、TEST_DATABASE_URL 的 port。
POSTGRES_PORT=5432

# --- 後端連線（必須用 postgresql+psycopg 驅動）---
# 主機固定寫 127.0.0.1：資料庫埠只綁 IPv4，寫 localhost 可能先試 ::1 而卡到逾時。
DATABASE_URL=postgresql+psycopg://foodflow:foodflow_local_dev@127.0.0.1:5432/foodflow
# 資料庫名稱必須以 _test 結尾；整合測試會清空這個資料庫。
TEST_DATABASE_URL=postgresql+psycopg://foodflow:foodflow_local_dev@127.0.0.1:5432/foodflow_test

# --- 認證（AD-15）---
# 必填，至少 32 bytes，未設定時後端拒絕啟動。在 backend/ 內產生：
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=12
AUTH_COOKIE_NAME=foodflow_session
# 區網 http demo 時維持 false；對外 HTTPS 才開啟。
AUTH_COOKIE_SECURE=false

# --- 執行環境（AD-10）---
# development、test、production
APP_ENV=development
# 固定「現在時間」供驗收與 demo 跨日，須含時區，例如 2026-11-18T09:00:00+08:00。
# APP_ENV=production 時會被忽略。
APP_FIXED_NOW=
