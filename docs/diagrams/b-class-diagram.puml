@startuml b-class-diagram
title 食序 FoodFlow｜領域類別圖（依現有程式）
top to bottom direction
hide circle
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Microsoft JhengHei
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam classBorderColor #64748B
skinparam classBackgroundColor white
skinparam ArrowColor #475569
skinparam ArrowFontSize 11
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam nodesep 45
skinparam ranksep 60

package "基本資料" #EFF6FF {
  class "員工\nEmployee" as Employee <<entity>> {
    +id : int
    +username : str
    +password_hash : str
    +name : str
    +role : EmployeeRole
    +is_active : bool
    +token_version : int
    +created_at : datetime
  }
  class "食材分類\nIngredientCategory" as IngredientCategory <<entity>> {
    +id : int
    +code : str
    +name : str
    +description : str | None
    +is_active : bool
    +created_at : datetime
  }
  class "食材\nIngredient" as Ingredient <<entity>> {
    +id : int
    +name : str
    +category_id : int
    +unit : str
    +storage_method : StorageType
    +safety_stock_quantity : Decimal
    +is_active : bool
    +created_at : datetime
  }
  class "供應商\nSupplier" as Supplier <<entity>> {
    +id : int
    +name : str
    +contact_person : str | None
    +phone : str | None
    +other_contact : str | None
    +is_active : bool
  }
  class "儲存位置\nStorageLocation" as StorageLocation <<entity>> {
    +id : int
    +code : str
    +name : str
    +storage_type : StorageType
    +description : str | None
    +is_active : bool
  }
}
package "進貨" #ECFDF5 {
  class "進貨單\nGoodsReceipt" as GoodsReceipt <<entity>> {
    +id : int
    +supplier_id : int
    +receipt_date : date
    +status : GoodsReceiptStatus
    +created_by_id : int
    +created_at : datetime
    +confirmed_at : datetime | None
    +/receipt_number : str <<property, readOnly>>
  }
  class "進貨明細\nGoodsReceiptItem" as GoodsReceiptItem <<entity>> {
    +id : int
    +receipt_id : int
    +ingredient_id : int
    +quantity : Decimal | None
    +unit_price : Decimal | None
    +expiry_date : date | None
    +location_id : int | None
    +note : str | None
  }
}
package "庫存與追溯" #FFF7ED {
  class "庫存批次\nInventoryBatch" as InventoryBatch <<entity>> {
    +id : int
    +batch_number : str
    +source_item_id : int
    +ingredient_id : int
    +expiry_date : date
    +received_date : date
    +current_location_id : int
    +unit_price : Decimal | None
    +initial_quantity : Decimal
    +remaining_quantity : Decimal
  }
  class "庫存異動\nInventoryTransaction" as InventoryTransaction <<entity>> {
    +id : int
    +operation_group_id : UUID
    +batch_id : int
    +type : TransactionType
    +quantity_delta : Decimal
    +quantity_before : Decimal
    +quantity_after : Decimal
    +operator_id : int
    +occurred_at : datetime
    +reason : str
    +is_non_fefo : bool
    +reverses_transaction_id : int | None
  }
  class "報廢紀錄\nWasteRecord" as WasteRecord <<entity>> {
    +id : int
    +batch_id : int
    +transaction_id : int
    +quantity : Decimal
    +reason : WasteReason
    +note : str | None
    +loss_amount : Decimal | None
    +operator_id : int
    +occurred_at : datetime
  }
  class "位置變更紀錄\nBatchLocationChange" as BatchLocationChange <<entity>> {
    +id : int
    +batch_id : int
    +from_location_id : int
    +to_location_id : int
    +operator_id : int
    +occurred_at : datetime
    +reason : str
  }
}
package "預警設定" #F5F3FF {
  class "預警設定\nAlertSetting" as AlertSetting <<entity>> {
    +id : int
    +name : str
    +warning_days : int
    +created_at : datetime
    +updated_at : datetime
    +updated_by_id : int | None
  }
}
Employee "0..1" -- "0..*" AlertSetting : updated_by
Employee "1" -- "0..*" BatchLocationChange : operator
Employee "1" -- "0..*" GoodsReceipt : created_by
Employee "1" -- "0..*" InventoryTransaction : operator
Employee "1" -- "0..*" WasteRecord : operator
GoodsReceipt "1" -- "0..*" GoodsReceiptItem : receipt / items
GoodsReceiptItem "1" -- "0..1" InventoryBatch : source_item
Ingredient "1" -- "0..*" GoodsReceiptItem : ingredient
Ingredient "1" -- "0..*" InventoryBatch : ingredient
IngredientCategory "1" -- "0..*" Ingredient : category
InventoryBatch "1" -- "0..*" BatchLocationChange : batch
InventoryBatch "1" -- "0..*" InventoryTransaction : batch
InventoryBatch "1" -- "0..*" WasteRecord : batch
InventoryTransaction "0..1" -- "0..1" InventoryTransaction : reverses
InventoryTransaction "1" -- "0..1" WasteRecord : transaction
StorageLocation "1" -- "0..*" BatchLocationChange : from_location
StorageLocation "1" -- "0..*" BatchLocationChange : to_location
StorageLocation "0..1" -- "0..*" GoodsReceiptItem : location
StorageLocation "1" -- "0..*" InventoryBatch : current_location
Supplier "1" -- "0..*" GoodsReceipt : supplier

legend bottom left
  + 公開屬性；/ 衍生唯讀屬性；T | None 可為空
  關聯名稱取自 relationship，雙向關聯以 / 分隔
  多重度依 schema；確認入庫的必填規則由 Service 檢查
  id 繼承自 IdMixin；省略 SQLAlchemy 基底與一般建構子
  列舉值與行為責任見 docs/b-class-model.md
endlegend
@enduml
