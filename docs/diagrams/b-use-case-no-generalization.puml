@startuml b-use-case-no-generalization
' 正式固定排版請編輯 b-use-case-no-generalization.drawio；本檔保留相同案例與角色關係供文字參考。


top to bottom direction
title 食序 FoodFlow－首版完整使用案例圖
skinparam defaultFontName Microsoft JhengHei
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 30
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #334155
skinparam packageBackgroundColor #F1F5F9
skinparam rectangleBorderColor #334155
skinparam ArrowColor #64748B

actor "一般員工" as staff
actor "管理者" as admin


rectangle "食序 FoodFlow：餐飲食材庫存與效期預警系統" {
  package "1.0 帳號與權限管理模組" as P1 {
    usecase "UC-01 登入與登出" as U01
    usecase "UC-02 員工帳號管理" as U02
  }
  package "2.0 基本資料與儲存位置管理模組" as P2 {
    usecase "UC-03 食材與分類管理" as U03
    usecase "UC-04 供應商管理" as U04
    usecase "UC-05 儲存位置管理" as U05
  }
  package "3.0 進貨與批次管理模組" as P3 {
    usecase "UC-06 建立進貨單與確認入庫" as U06
    usecase "UC-07 查詢進貨" as U07
    usecase "UC-08 沖銷進貨" as U08
  }
  package "4.0 批次庫存查詢模組" as P4 {
    usecase "UC-09 查詢庫存總覽" as U09
    usecase "UC-10 查看批次與異動" as U10
  }
  package "5.0 食材領用與消耗登記模組" as P5 {
    usecase "UC-11 登記領用與扣庫存\n（含 FEFO 領用建議）" as U11
  }
  package "6.0 效期與低庫存預警模組" as P6 {
    usecase "UC-12 預警首頁\n（效期與低庫存提醒）" as U12
    usecase "UC-13 預警設定" as U13
  }
  package "7.0 報廢與盤點模組" as P7 {
    usecase "UC-14 報廢登記" as U14
    usecase "UC-15 盤點調整" as U15
  }
  package "8.0 異動紀錄與統計模組" as P8 {
    usecase "UC-16 查詢庫存異動" as U16
    usecase "UC-17 庫存統計" as U17
    usecase "UC-18 報廢統計\n（報廢分布與損失金額）" as U18
  }
}


U01 -[hidden]down-> U02
U03 -[hidden]down-> U04
U04 -[hidden]down-> U05
U06 -[hidden]down-> U07
U07 -[hidden]down-> U08
U09 -[hidden]down-> U10
U12 -[hidden]down-> U13
U14 -[hidden]down-> U15
U16 -[hidden]down-> U17
U17 -[hidden]down-> U18


U01 -[hidden]right-> U03
U06 -[hidden]right-> U09
U11 -[hidden]right-> U12
U14 -[hidden]right-> U16
U02 -[hidden]down-> U06
U05 -[hidden]down-> U09
U08 -[hidden]down-> U11
U10 -[hidden]down-> U12
U11 -[hidden]down-> U14
U13 -[hidden]down-> U16

staff -- U01
admin -- U01
